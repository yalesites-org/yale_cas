<?php

/**
 * @file
 * Provides Yale CAS customizations.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Alters the user entity form.
 */
function yale_cas_form_user_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Alter the user login form.
  $casSettingsService = \Drupal::service('yale_cas.settings');
  $casSettingsService->userFormAlter($form, $form_state);
}

/**
 * Implements hook_form_alter().
 *
 * Lowercases CAS usernames on the forms where they are entered.
 */
function yale_cas_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (in_array($form_id, ['user_form', 'user_register_form', 'bulk_add_cas_users'], TRUE)) {
    array_unshift($form['#validate'], 'yale_cas_lowercase_cas_usernames');
  }
}

/**
 * Validate handler: lowercases CAS usernames before the cas module reads them.
 *
 * Since externalauth 2.0.13, authnames match case-sensitively. Yale CAS
 * returns lowercase NetIDs, so a username saved with capitals cannot log in.
 * Runs first so cas's own validate and submit handlers see the lowercase value.
 */
function yale_cas_lowercase_cas_usernames(array &$form, FormStateInterface $form_state) {
  // cas_username: add/edit user forms. cas_usernames: Bulk Add CAS Users.
  foreach (['cas_username', 'cas_usernames'] as $key) {
    $value = $form_state->getValue($key);
    if (is_string($value)) {
      $form_state->setValue($key, mb_strtolower($value));
    }
  }
}
