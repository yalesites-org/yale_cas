<?php

/**
 * Implements hook_install().
 */
function yale_cas_install() {
  // Set the default configuration of the 'cas' module.
  $updateCasConfig = \Drupal::configFactory()
    ->getEditable('cas.settings')
    ->get();
  $updateCasConfig['login_link_enabled'] = true;
  $updateCasConfig['login_link_label'] = 'Login with CAS';
  $updateCasConfig['login_success_message'] = '';
  $updateCasConfig['server'] = [
    'version' => '3.0',
    'protocol' => 'https',
    'hostname' => 'secure.its.yale.edu',
    'port' => 443,
    'path' => '/cas',
    'verify' => 0,
    'cert' => '',
  ];
  \Drupal::configFactory()
    ->getEditable('cas.settings')
    ->setData($updateCasConfig)
    ->save();

  // Set the default configuration of the 'cas_attributes' module.
  $updateCasAttrConfig = \Drupal::configFactory()
    ->getEditable('cas_attributes.settings')
    ->get();
  $updateCasAttrConfig['sitewide_token_support'] = true;
  $updateCasAttrConfig['field'] = [
    'sync_frequency' => '2',
    'overwrite' => 'true',
    'mappings' => [
      'mail' => '[cas:attribute:mail]',
    ],
  ];
  \Drupal::configFactory()
    ->getEditable('cas_attributes.settings')
    ->setData($updateCasAttrConfig)
    ->save();
}

/**
 * Lowercase CAS usernames in the authmap table.
 */
function yale_cas_update_10001() {
  $database = \Drupal::database();
  $authnames = $database->select('authmap', 'a')
    ->fields('a', ['uid', 'authname'])
    ->condition('provider', 'cas')
    ->execute()
    ->fetchAllKeyed();

  $groups = [];
  foreach ($authnames as $uid => $authname) {
    $groups[mb_strtolower($authname)][$uid] = $authname;
  }

  $updated = 0;
  $collisions = 0;
  foreach ($groups as $lowercase => $accounts) {
    if (count($accounts) > 1) {
      // Two accounts whose CAS usernames differ only by case: a human has to
      // decide which one is real, so leave both alone.
      $collisions++;
      \Drupal::logger('yale_cas')->warning('CAS usernames @names (uids @uids) differ only by case and were not lowercased. Merge or remove the duplicate account.', [
        '@names' => implode(', ', $accounts),
        '@uids' => implode(', ', array_keys($accounts)),
      ]);
      continue;
    }
    $uid = array_key_first($accounts);
    if ($accounts[$uid] !== (string) $lowercase) {
      $database->update('authmap')
        ->fields(['authname' => $lowercase])
        ->condition('uid', $uid)
        ->condition('provider', 'cas')
        ->execute();
      $updated++;
    }
  }

  return t('Lowercased @updated CAS usernames. Skipped @collisions case-only duplicates (see the yale_cas log).', [
    '@updated' => $updated,
    '@collisions' => $collisions,
  ]);
}
